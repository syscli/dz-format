{
  "name": "@syscli/dz-format",
  "version": "0.1.0",
  "description": "Validate and parse Algerian formats: phone numbers, CCP, RIP and RIB keys, vehicle plates, wilaya codes.",
  "type": "module",
  "license": "MIT",
  "author": "Sysserv <me@sysserv.eu.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syscli/dz-format.git"
  },
  "homepage": "https://github.com/syscli/dz-format#readme",
  "bugs": {
    "url": "https://github.com/syscli/dz-format/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "algeria",
    "algerie",
    "dz",
    "validation",
    "phone",
    "ccp",
    "rip",
    "rib",
    "wilaya"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
